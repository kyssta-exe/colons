# ============================================================
# Colons configuration - copy to `.env` and edit
# ============================================================

# --- Provider -------------------------------------------------
# Any name from the catalog: openai, anthropic, google, openrouter,
# groq, together, deepseek, xai, mistral, perplexity, cerebras,
# sambanova, nvidia, github-models, ollama, lmstudio, vllm, llamacpp,
# localai, jan, koboldcpp, custom, ...
COLONS_PROVIDER=ollama

# API key for the chosen provider (not needed for local runtimes)
COLONS_API_KEY=

# Override the provider base URL (useful for custom/self-hosted endpoints)
COLONS_BASE_URL=

# Model to use (leave empty for the provider's sensible default)
COLONS_MODEL=

# --- Memory ---------------------------------------------------
# SQLite file by default; set a postgres:// URL to use Postgres + pgvector
COLONS_STORE_URL=./data/memory.db

# Cache: leave empty for the built-in in-memory cache, or use Redis
COLONS_CACHE_URL=
# COLONS_CACHE_URL=redis://localhost:6379/0

# --- Tools ----------------------------------------------------
# Workspace root that filesystem tools may touch
COLONS_WORKSPACE=./workspace
# Bypass approval prompts (dangerous - only for trusted environments)
COLONS_AUTO_APPROVE=false

# --- Voice ----------------------------------------------------
# Enable text-to-speech (Microsoft Edge TTS when edge-tts is installed)
COLONS_VOICE_ENABLED=false
COLONS_TTS_ENGINE=edge
COLONS_TTS_VOICE=en-US-AriaNeural
COLONS_AUTOSPEAK=false

# --- Agent ----------------------------------------------------
COLONS_PROACTIVE=true
COLONS_MAX_TOKENS=4096

# --- Scheduler (cronjobs) -------------------------------------
COLONS_SCHEDULER_ENABLED=true
COLONS_SCHEDULER_TICK=15
COLONS_TIMEZONE=UTC

# --- Messaging integrations -----------------------------------
# Telegram: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=

# Discord: create an app at https://discord.com/developers/applications
# and enable the MESSAGE CONTENT privileged intent for the bot.
DISCORD_BOT_TOKEN=

# Slack: either an incoming webhook, a bot token, or both.
# Set SLACK_SIGNING_SECRET to verify Events API requests.
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- Logging --------------------------------------------------
COLONS_LOG_LEVEL=INFO
# Optional rotating log file, e.g. ./data/colons.log
COLONS_LOG_FILE=
# One JSON object per log line (for log shippers)
COLONS_LOG_JSON=false

# --- Server ---------------------------------------------------
COLONS_HOST=127.0.0.1
COLONS_PORT=8000
# Comma-separated API keys. Leave empty for open local-only use.
COLONS_API_KEYS=
# Additional browser UI origins, comma-separated; same-origin requests are always allowed.
COLONS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Data -----------------------------------------------------
COLONS_DATA_DIR=./data
